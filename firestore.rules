rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // User caches associated by Moodle credentials composite keys (e.g. "a_username")
    match /user_data/{userId} {
      // Allowed since there is no Firebase Auth used, but fully validated for schema integrity
      allow read: if true;
      allow create, update: if isValidId(userId) 
        && isValidUserCache(request.resource.data)
        && (request.resource.data.get('lastSyncedTime', null) == null 
            || request.resource.data.get('lastSyncedTime', null) is int 
            || request.resource.data.get('lastSyncedTime', null) is float);
      allow delete: if false;

      // Append-only sync audit trail for every Moodle account.
      match /sync_history/{syncId} {
        allow read: if true;
        allow create: if isValidId(userId)
          && request.resource.data.moodleUsername is string
          && request.resource.data.moodleUsername.size() > 0
          && request.resource.data.moodleUsername.size() <= 100
          && request.resource.data.moodleServer is string
          && request.resource.data.moodleServer.matches('^(a|b|upsdt|other_[a-z0-9_]+)$')
          && request.resource.data.syncId == syncId
          && request.resource.data.status in ['completed', 'failed']
          && request.resource.data.activityChanges is list
          && request.resource.data.notifications is list
          && request.resource.data.logs is list;
        allow update, delete: if false;
      }
    }

    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserCache(data) {
      return data.keys().hasAll(['moodleUsername', 'moodleServer', 'tasks'])
        && data.moodleUsername is string
        && data.moodleUsername.size() <= 100
        && data.moodleServer is string
        && (data.moodleServer == 'a' || data.moodleServer == 'b' || data.moodleServer == 'upsdt')
        && data.tasks is list
        && data.tasks.size() <= 1200
        && (data.get('notifications', null) == null || data.notifications is list);
    }
  }
}
